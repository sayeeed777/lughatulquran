{
  "name": "quran-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build:search-index && npm run split:quran-seo-text",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "normalize:translations": "node scripts/normalize-translation-json.mjs",
    "verify:prayer": "node scripts/verify-prayer-times.mjs",
    "build:prayer-locations-supplemental": "node scripts/build-prayer-locations-supplemental.mjs",
    "build:search-index": "node scripts/build-quran-search-index.mjs",
    "ingest:root-explorer": "node scripts/fetch-root-explorer.mjs",
    "ingest:audio-timings": "node scripts/fetch-audio-timings.mjs",
    "split:quran-seo-text": "node scripts/split-quran-seo-text.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "adhan": "^4.4.3",
    "framer-motion": "^12.31.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
