{"1":{"ar":"قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","en":"Say, \"O disbelievers,","tj":"قُلْ يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١</span>","pg":603},"2":{"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","en":"I do not worship what you worship.","tj":"ل<tajweed class=madda_obligatory>َآ</tajweed> أَعْبُدُ مَا تَعْبُد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢</span>","pg":603},"3":{"ar":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","en":"Nor are you worshippers of what I worship.","tj":"وَل<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ عَ<tajweed class=madda_normal>ـٰ</tajweed>بِدُونَ م<tajweed class=madda_obligatory>َآ</tajweed> أَعْبُ<tajweed class=qalaqah>د</tajweed>ُ <span class=end>٣</span>","pg":603},"4":{"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","en":"Nor will I be a worshipper of what you worship.","tj":"وَل<tajweed class=madda_obligatory>َآ</tajweed> أَنَا۟ عَابِ<tajweed class=idgham_ghunnah>دٌ م</tajweed>َّا عَبَ<tajweed class=idgham_mutajanisayn>د</tajweed>تُّمْ <span class=end>٤</span>","pg":603},"5":{"ar":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","en":"Nor will you be worshippers of what I worship.","tj":"وَل<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ عَ<tajweed class=madda_normal>ـٰ</tajweed>بِدُونَ م<tajweed class=madda_obligatory>َآ</tajweed> أَعْبُ<tajweed class=qalaqah>د</tajweed>ُ <span class=end>٥</span>","pg":603},"6":{"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","en":"For you is your religion, and for me is my religion.\"","tj":"لَكُمْ دِينُكُمْ وَلِىَ د<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٦</span>","pg":603}}