{"1":{"ar":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","en":"Competition in [worldly] increase diverts you","tj":"أَلْهَ<tajweed class=madda_normal>ـٰ</tajweed>كُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّكَاثُرُ <span class=end>١</span>","pg":600},"2":{"ar":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","en":"Until you visit the graveyards.","tj":"حَتَّىٰ زُرْتُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَقَابِرَ <span class=end>٢</span>","pg":600},"3":{"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","en":"No! You are going to know.","tj":"كَلَّا سَوْفَ تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","pg":600},"4":{"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","en":"Then no! You are going to know.","tj":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ كَلَّا سَوْفَ تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤</span>","pg":600},"5":{"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","en":"No! If you only knew with knowledge of certainty...","tj":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ <tajweed class=ham_wasl>ٱ</tajweed>لْيَق<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٥</span>","pg":600},"6":{"ar":"لَتَرَوُنَّ ٱلْجَحِيمَ","en":"You will surely see the Hellfire.","tj":"لَتَرَوُ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْجَح<tajweed class=madda_permissible>ِي</tajweed>مَ <span class=end>٦</span>","pg":600},"7":{"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","en":"Then you will surely see it with the eye of certainty.","tj":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ لَتَرَوُ<tajweed class=ghunnah>نّ</tajweed>َهَا عَيْنَ <tajweed class=ham_wasl>ٱ</tajweed>لْيَق<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٧</span>","pg":600},"8":{"ar":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","en":"Then you will surely be asked that Day about pleasure.","tj":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ لَتُسْــَٔلُ<tajweed class=ghunnah>نّ</tajweed>َ يَوْمَئِذٍ عَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َع<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>٨</span>","pg":600}}