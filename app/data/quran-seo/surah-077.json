{"1":{"ar":"وَٱلْمُرْسَلَـٰتِ عُرْفًۭا","en":"By those [winds] sent forth in gusts","tj":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْمُرْسَلَ<tajweed class=madda_normal>ـٰ</tajweed>تِ عُرْفًا <span class=end>١</span>","pg":580},"2":{"ar":"فَٱلْعَـٰصِفَـٰتِ عَصْفًۭا","en":"And the winds that blow violently","tj":"فَ<tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>صِفَ<tajweed class=madda_normal>ـٰ</tajweed>تِ عَصْفًا <span class=end>٢</span>","pg":580},"3":{"ar":"وَٱلنَّـٰشِرَٰتِ نَشْرًۭا","en":"And [by] the winds that spread [clouds]","tj":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>شِر<tajweed class=madda_normal>َٲ</tajweed>تِ نَشْرًا <span class=end>٣</span>","pg":580},"4":{"ar":"فَٱلْفَـٰرِقَـٰتِ فَرْقًۭا","en":"And those [angels] who bring criterion","tj":"فَ<tajweed class=ham_wasl>ٱ</tajweed>لْفَ<tajweed class=madda_normal>ـٰ</tajweed>رِقَ<tajweed class=madda_normal>ـٰ</tajweed>تِ فَرْقًا <span class=end>٤</span>","pg":580},"5":{"ar":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا","en":"And those [angels] who deliver a message","tj":"فَ<tajweed class=ham_wasl>ٱ</tajweed>لْمُلْقِيَ<tajweed class=madda_normal>ـٰ</tajweed>تِ ذِكْرًا <span class=end>٥</span>","pg":580},"6":{"ar":"عُذْرًا أَوْ نُذْرًا","en":"As justification or warning,","tj":"عُذْرًا أَوْ نُذْرًا <span class=end>٦</span>","pg":580},"7":{"ar":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ","en":"Indeed, what you are promised is to occur.","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َمَا تُوعَدُونَ لَو<tajweed class=madda_normal>َٲ</tajweed>قِعٌ <span class=end>٧</span>","pg":580},"8":{"ar":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","en":"So when the stars are obliterated","tj":"فَإِذَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>ُجُومُ طُمِسَتْ <span class=end>٨</span>","pg":580},"9":{"ar":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","en":"And when the heaven is opened","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءُ فُرِجَتْ <span class=end>٩</span>","pg":580},"10":{"ar":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","en":"And when the mountains are blown away","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed>لْجِبَالُ نُسِفَتْ <span class=end>١٠</span>","pg":580},"11":{"ar":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","en":"And when the messengers' time has come...","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رُّسُلُ أُقِّتَتْ <span class=end>١١</span>","pg":580},"12":{"ar":"لِأَىِّ يَوْمٍ أُجِّلَتْ","en":"For what Day was it postponed?","tj":"لِأَىِّ يَوْمٍ أُجِّلَتْ <span class=end>١٢</span>","pg":580},"13":{"ar":"لِيَوْمِ ٱلْفَصْلِ","en":"For the Day of Judgement.","tj":"لِيَوْمِ <tajweed class=ham_wasl>ٱ</tajweed>لْفَصْلِ <span class=end>١٣</span>","pg":580},"14":{"ar":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","en":"And what can make you know what is the Day of Judgement?","tj":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=qalaqah>دْ</tajweed>رَ<tajweed class=madda_normal>ٮٰ</tajweed>كَ مَا يَوْمُ <tajweed class=ham_wasl>ٱ</tajweed>لْفَصْلِ <span class=end>١٤</span>","pg":580},"15":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٥</span>","pg":580},"16":{"ar":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","en":"Did We not destroy the former peoples?","tj":"أَلَمْ نُهْلِكِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٦</span>","pg":580},"17":{"ar":"ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ","en":"Then We will follow them with the later ones.","tj":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ نُتْبِعُهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَخِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٧</span>","pg":580},"18":{"ar":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","en":"Thus do We deal with the criminals.","tj":"كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ نَفْعَلُ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٨</span>","pg":580},"19":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٩</span>","pg":580},"20":{"ar":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ","en":"Did We not create you from a liquid disdained?","tj":"أَلَمْ نَخْلُ<tajweed class=idgham_mutaqaribayn>ق</tajweed>كّ<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن م</tajweed>ّ<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=idgham_ghunnah>ءٍ م</tajweed>َّه<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٢٠</span>","pg":581},"21":{"ar":"فَجَعَلْنَـٰهُ فِى قَرَارٍۢ مَّكِينٍ","en":"And We placed it in a firm lodging","tj":"فَجَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ فِى قَرَا<tajweed class=idgham_ghunnah>رٍ م</tajweed>َّك<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٢١</span>","pg":581},"22":{"ar":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ","en":"For a known extent.","tj":"إِلَىٰ قَدَ<tajweed class=idgham_ghunnah>رٍ م</tajweed>َّعْل<tajweed class=madda_permissible>ُو</tajweed>مٍ <span class=end>٢٢</span>","pg":581},"23":{"ar":"فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ","en":"And We determined [it], and excellent [are We] to determine.","tj":"فَقَدَرْنَا فَنِعْمَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَ<tajweed class=madda_normal>ـٰ</tajweed>دِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٣</span>","pg":581},"24":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٤</span>","pg":581},"25":{"ar":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","en":"Have We not made the earth a container","tj":"أَلَمْ نَ<tajweed class=qalaqah>جْ</tajweed>عَلِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ كِفَاتًا <span class=end>٢٥</span>","pg":581},"26":{"ar":"أَحْيَآءًۭ وَأَمْوَٰتًۭا","en":"Of the living and the dead?","tj":"أَحْي<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=idgham_ghunnah>ءً و</tajweed>َأَمْو<tajweed class=madda_normal>َٲ</tajweed>تًا <span class=end>٢٦</span>","pg":581},"27":{"ar":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍۢ وَأَسْقَيْنَـٰكُم مَّآءًۭ فُرَاتًۭا","en":"And We placed therein lofty, firmly set mountains and have given you to drink sweet water.","tj":"وَجَعَلْنَا فِيهَا رَو<tajweed class=madda_normal>َٲ</tajweed>سِىَ شَ<tajweed class=madda_normal>ـٰ</tajweed>مِخَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ و</tajweed>َأَسْقَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>ك<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=ikhafa>ءً ف</tajweed>ُرَاتًا <span class=end>٢٧</span>","pg":581},"28":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٨</span>","pg":581},"29":{"ar":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","en":"[They will be told], \"Proceed to that which you used to deny.","tj":"ٱ<tajweed class=ikhafa>نط</tajweed>َلِق<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَىٰ مَا كُ<tajweed class=ikhafa>نت</tajweed><tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> تُكَذِّب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٩</span>","pg":581},"30":{"ar":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَـٰثِ شُعَبٍۢ","en":"Proceed to a shadow [of smoke] having three columns","tj":"ٱ<tajweed class=ikhafa>نط</tajweed>َلِق<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَىٰ ظِ<tajweed class=ikhafa>لٍّ ذ</tajweed>ِى ثَلَ<tajweed class=madda_normal>ـٰ</tajweed>ثِ شُعَ<tajweed class=qalaqah>ب</tajweed>ٍ <span class=end>٣٠</span>","pg":581},"31":{"ar":"لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","en":"[But having] no cool shade and availing not against the flame.\"","tj":"لَّا ظَلِي<tajweed class=idgham_ghunnah>لٍ و</tajweed>َلَا يُغْنِى مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>لَّهَ<tajweed class=qalaqah>ب</tajweed>ِ <span class=end>٣١</span>","pg":581},"32":{"ar":"إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ","en":"Indeed, it throws sparks [as huge] as a fortress,","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َهَا تَرْمِى بِشَرَ<tajweed class=ikhafa>رٍ ك</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>لْقَصْرِ <span class=end>٣٢</span>","pg":581},"33":{"ar":"كَأَنَّهُۥ جِمَـٰلَتٌۭ صُفْرٌۭ","en":"As if they were yellowish [black] camels.","tj":"كَأَ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> جِمَ<tajweed class=madda_normal>ـٰ</tajweed>لَ<tajweed class=ikhafa>تٌ ص</tajweed>ُفْرٌ <span class=end>٣٣</span>","pg":581},"34":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٤</span>","pg":581},"35":{"ar":"هَـٰذَا يَوْمُ لَا يَنطِقُونَ","en":"This is a Day they will not speak,","tj":"هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا يَوْمُ لَا يَ<tajweed class=ikhafa>نط</tajweed>ِق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٥</span>","pg":581},"36":{"ar":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","en":"Nor will it be permitted for them to make an excuse.","tj":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٦</span>","pg":581},"37":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٧</span>","pg":581},"38":{"ar":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ","en":"This is the Day of Judgement; We will have assembled you and the former peoples.","tj":"هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا يَوْمُ <tajweed class=ham_wasl>ٱ</tajweed>لْفَصْلِ‌ۖ جَمَعْنَ<tajweed class=madda_normal>ـٰ</tajweed>كُمْ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٨</span>","pg":581},"39":{"ar":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","en":"So if you have a plan, then plan against Me.","tj":"فَإِ<tajweed class=ikhafa>ن ك</tajweed>َانَ لَكُمْ كَيْ<tajweed class=ikhafa>دٌ ف</tajweed>َكِيد<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٣٩</span>","pg":581},"40":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٠</span>","pg":581},"41":{"ar":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍۢ وَعُيُونٍۢ","en":"Indeed, the righteous will be among shades and springs","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَّقِينَ فِى ظِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ و</tajweed>َعُي<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>٤١</span>","pg":581},"42":{"ar":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","en":"And fruits from whatever they desire,","tj":"وَفَو<tajweed class=madda_normal>َٲ</tajweed>كِهَ مِ<tajweed class=ghunnah>مّ</tajweed>َا يَشْتَه<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٢</span>","pg":581},"43":{"ar":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","en":"[Being told], \"Eat and drink in satisfaction for what you used to do.\"","tj":"كُلُو<tajweed class=slnt>اْ</tajweed> وَ<tajweed class=ham_wasl>ٱ</tajweed>شْرَبُو<tajweed class=slnt>اْ</tajweed> هَنِ<tajweed class=madda_obligatory>يٓـ</tajweed>ـ<tajweed class=iqlab>ـَٔۢا ب</tajweed>ِمَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٣</span>","pg":581},"44":{"ar":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","en":"Indeed, We thus reward the doers of good.","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َا كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ نَ<tajweed class=qalaqah>جْ</tajweed>زِى <tajweed class=ham_wasl>ٱ</tajweed>لْمُحْسِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٤</span>","pg":581},"45":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٥</span>","pg":581},"46":{"ar":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","en":"[O disbelievers], eat and enjoy yourselves a little; indeed, you are criminals.","tj":"كُلُو<tajweed class=slnt>اْ</tajweed> وَتَمَتَّعُو<tajweed class=slnt>اْ</tajweed> قَلِيلاً إِ<tajweed class=ghunnah>نّ</tajweed>َك<tajweed class=idgham_shafawi>ُم م</tajweed>ُّ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٦</span>","pg":581},"47":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٧</span>","pg":581},"48":{"ar":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","en":"And when it is said to them, \"Bow [in prayer],\" they do not bow.","tj":"وَإِذَا قِيلَ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>رْكَعُو<tajweed class=slnt>اْ</tajweed> لَا يَرْكَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٨</span>","pg":581},"49":{"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","en":"Woe, that Day, to the deniers.","tj":"وَيْ<tajweed class=idgham_ghunnah>لٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>ِّلْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٩</span>","pg":581},"50":{"ar":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","en":"Then in what statement after the Qur'an will they believe?","tj":"فَبِأَىِّ حَدِي<tajweed class=iqlab>ثِۭ ب</tajweed>َعْدَهُ<tajweed class=madda_normal>ۥ</tajweed> يُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٠</span>","pg":581}}