{"1":{"ar":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","en":"Recite in the name of your Lord who created -","tj":"ٱ<tajweed class=qalaqah>قْ</tajweed>رَأْ بِ<tajweed class=ham_wasl>ٱ</tajweed>سْمِ رَبِّكَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَ<tajweed class=qalaqah>ق</tajweed>َ <span class=end>١</span>","pg":597},"2":{"ar":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","en":"Created man from a clinging substance.","tj":"خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ مِنْ عَلَ<tajweed class=qalaqah>ق</tajweed>ٍ <span class=end>٢</span>","pg":597},"3":{"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","en":"Recite, and your Lord is the most Generous -","tj":"ٱ<tajweed class=qalaqah>قْ</tajweed>رَأْ وَرَبُّكَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَكْرَمُ <span class=end>٣</span>","pg":597},"4":{"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","en":"Who taught by the pen -","tj":"ٱلَّذِى عَلَّمَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْقَلَمِ <span class=end>٤</span>","pg":597},"5":{"ar":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","en":"Taught man that which he knew not.","tj":"عَلَّمَ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ مَا لَمْ يَعْلَمْ <span class=end>٥</span>","pg":597},"6":{"ar":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","en":"No! [But] indeed, man transgresses","tj":"كَلّ<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ لَيَ<tajweed class=qalaqah>طْ</tajweed>غَىٰٓ <span class=end>٦</span>","pg":597},"7":{"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","en":"Because he sees himself self-sufficient.","tj":"أ<tajweed class=idgham_wo_ghunnah>َن ر</tajweed>َّءَاهُ <tajweed class=ham_wasl>ٱ</tajweed>سْتَغْنَىٰٓ <span class=end>٧</span>","pg":597},"8":{"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","en":"Indeed, to your Lord is the return.","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َ إِلَىٰ رَبِّكَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رُّ<tajweed class=qalaqah>جْ</tajweed>عَىٰٓ <span class=end>٨</span>","pg":597},"9":{"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","en":"Have you seen the one who forbids","tj":"أَرَءَيْتَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يَنْهَىٰ <span class=end>٩</span>","pg":597},"10":{"ar":"عَبْدًا إِذَا صَلَّىٰٓ","en":"A servant when he prays?","tj":"عَ<tajweed class=qalaqah>بْ</tajweed>دًا إِذَا صَلَّىٰٓ <span class=end>١٠</span>","pg":597},"11":{"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","en":"Have you seen if he is upon guidance","tj":"أَرَءَيْتَ إِ<tajweed class=ikhafa>ن ك</tajweed>َانَ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْهُدَىٰٓ <span class=end>١١</span>","pg":597},"12":{"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","en":"Or enjoins righteousness?","tj":"أَوْ أَمَرَ بِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّ<tajweed class=qalaqah>قْ</tajweed>وَىٰٓ <span class=end>١٢</span>","pg":597},"13":{"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","en":"Have you seen if he denies and turns away -","tj":"أَرَءَيْتَ إِ<tajweed class=ikhafa>ن ك</tajweed>َذَّبَ وَتَوَلَّىٰٓ <span class=end>١٣</span>","pg":598},"14":{"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","en":"Does he not know that Allah sees?","tj":"أَلَمْ يَعْل<tajweed class=ikhafa_shafawi>َم ب</tajweed>ِأَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ يَرَىٰ <span class=end>١٤</span>","pg":598},"15":{"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","en":"No! If he does not desist, We will surely drag him by the forelock -","tj":"كَلَّا لَئ<tajweed class=idgham_wo_ghunnah>ِن ل</tajweed>َّمْ يَ<tajweed class=ikhafa>نت</tajweed>َهِ لَنَسْفَع<tajweed class=iqlab>َۢا ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاصِيَةِ <span class=end>١٥</span>","pg":598},"16":{"ar":"نَاصِيَةٍۢ كَـٰذِبَةٍ خَاطِئَةٍۢ","en":"A lying, sinning forelock.","tj":"نَاصِيَ<tajweed class=ikhafa>ةٍ ك</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>ذِبَةٍ خَاطِئَةٍ <span class=end>١٦</span>","pg":598},"17":{"ar":"فَلْيَدْعُ نَادِيَهُۥ","en":"Then let him call his associates;","tj":"فَلْيَ<tajweed class=qalaqah>دْ</tajweed>عُ نَادِيَهُۥ <span class=end>١٧</span>","pg":598},"18":{"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","en":"We will call the angels of Hell.","tj":"سَنَ<tajweed class=qalaqah>دْ</tajweed>عُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زَّبَانِيَةَ <span class=end>١٨</span>","pg":598},"19":{"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","en":"No! Do not obey him. But prostrate and draw near [to Allah].","tj":"كَلَّا لَا تُطِعْهُ وَ<tajweed class=ham_wasl>ٱ</tajweed>سْجُ<tajweed class=qalaqah>دْ</tajweed> وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>قْ</tajweed>تَرِ<tajweed class=qalaqah>ب</tajweed> ۩ <span class=end>١٩</span>","pg":598}}