{"1":{"ar":"عَبَسَ وَتَوَلَّىٰٓ","en":"The Prophet frowned and turned away","tj":"عَبَسَ وَتَوَلَّىٰٓ <span class=end>١</span>","pg":585},"2":{"ar":"أَن جَآءَهُ ٱلْأَعْمَىٰ","en":"Because there came to him the blind man, [interrupting].","tj":"أَ<tajweed class=ikhafa>ن ج</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءَهُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَعْمَىٰ <span class=end>٢</span>","pg":585},"3":{"ar":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","en":"But what would make you perceive, [O Muhammad], that perhaps he might be purified","tj":"وَمَا يُ<tajweed class=qalaqah>دْ</tajweed>رِيكَ لَعَلَّهُ<tajweed class=madda_normal>ۥ</tajweed> يَزَّكَّىٰٓ <span class=end>٣</span>","pg":585},"4":{"ar":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","en":"Or be reminded and the remembrance would benefit him?","tj":"أَوْ يَذَّكَّرُ فَتَ<tajweed class=ikhafa>نف</tajweed>َعَهُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرَىٰٓ <span class=end>٤</span>","pg":585},"5":{"ar":"أَمَّا مَنِ ٱسْتَغْنَىٰ","en":"As for he who thinks himself without need,","tj":"أَ<tajweed class=ghunnah>مّ</tajweed>َا مَنِ <tajweed class=ham_wasl>ٱ</tajweed>سْتَغْنَىٰ <span class=end>٥</span>","pg":585},"6":{"ar":"فَأَنتَ لَهُۥ تَصَدَّىٰ","en":"To him you give attention.","tj":"فَأَ<tajweed class=ikhafa>نت</tajweed>َ لَهُ<tajweed class=madda_normal>ۥ</tajweed> تَصَدَّىٰ <span class=end>٦</span>","pg":585},"7":{"ar":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","en":"And not upon you [is any blame] if he will not be purified.","tj":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ <span class=end>٧</span>","pg":585},"8":{"ar":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","en":"But as for he who came to you striving [for knowledge]","tj":"وَأَ<tajweed class=ghunnah>مّ</tajweed>َا مَ<tajweed class=ikhafa>ن ج</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءَكَ يَسْعَىٰ <span class=end>٨</span>","pg":585},"9":{"ar":"وَهُوَ يَخْشَىٰ","en":"While he fears [Allah],","tj":"وَهُوَ يَخْشَىٰ <span class=end>٩</span>","pg":585},"10":{"ar":"فَأَنتَ عَنْهُ تَلَهَّىٰ","en":"From him you are distracted.","tj":"فَأَ<tajweed class=ikhafa>نت</tajweed>َ عَنْهُ تَلَهَّىٰ <span class=end>١٠</span>","pg":585},"11":{"ar":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","en":"No! Indeed, these verses are a reminder;","tj":"كَلّ<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهَا تَذْكِرَةٌ <span class=end>١١</span>","pg":585},"12":{"ar":"فَمَن شَآءَ ذَكَرَهُۥ","en":"So whoever wills may remember it.","tj":"فَمَ<tajweed class=ikhafa>ن ش</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءَ ذَكَرَهُۥ <span class=end>١٢</span>","pg":585},"13":{"ar":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","en":"[It is recorded] in honored sheets,","tj":"فِى صُحُ<tajweed class=idgham_ghunnah>فٍ م</tajweed>ُّكَرَّمَةٍ <span class=end>١٣</span>","pg":585},"14":{"ar":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","en":"Exalted and purified,","tj":"مَّرْفُوعَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ُّطَهَّرَةِۭ <span class=end>١٤</span>","pg":585},"15":{"ar":"بِأَيْدِى سَفَرَةٍۢ","en":"[Carried] by the hands of messenger-angels,","tj":"بِأَيْدِى سَفَرَةٍ <span class=end>١٥</span>","pg":585},"16":{"ar":"كِرَامٍۭ بَرَرَةٍۢ","en":"Noble and dutiful.","tj":"كِرَا<tajweed class=iqlab>مِۭ ب</tajweed>َرَرَةٍ <span class=end>١٦</span>","pg":585},"17":{"ar":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","en":"Cursed is man; how disbelieving is he.","tj":"قُتِلَ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نُ م<tajweed class=madda_obligatory>َآ</tajweed> أَكْفَرَهُۥ <span class=end>١٧</span>","pg":585},"18":{"ar":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","en":"From what substance did He create him?","tj":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ <span class=end>١٨</span>","pg":585},"19":{"ar":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","en":"From a sperm-drop He created him and destined for him;","tj":"م<tajweed class=idgham_ghunnah>ِن ن</tajweed>ُّ<tajweed class=qalaqah>طْ</tajweed>فَةٍ خَلَقَهُ<tajweed class=madda_normal>ۥ</tajweed> فَقَدَّرَهُۥ <span class=end>١٩</span>","pg":585},"20":{"ar":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","en":"Then He eased the way for him;","tj":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّبِيلَ يَسَّرَهُۥ <span class=end>٢٠</span>","pg":585},"21":{"ar":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","en":"Then He causes his death and provides a grave for him.","tj":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ أَمَاتَهُ<tajweed class=madda_normal>ۥ</tajweed> فَأَ<tajweed class=qalaqah>قْ</tajweed>بَرَهُۥ <span class=end>٢١</span>","pg":585},"22":{"ar":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","en":"Then when He wills, He will resurrect him.","tj":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ إِذَا ش<tajweed class=madda_obligatory>َا</tajweed>ٓءَ أَ<tajweed class=ikhafa>نش</tajweed>َرَهُۥ <span class=end>٢٢</span>","pg":585},"23":{"ar":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","en":"No! Man has not yet accomplished what He commanded him.","tj":"كَلَّا لَ<tajweed class=ghunnah>مّ</tajweed>َا يَ<tajweed class=qalaqah>قْ</tajweed>ضِ م<tajweed class=madda_obligatory>َآ</tajweed> أَمَرَهُۥ <span class=end>٢٣</span>","pg":585},"24":{"ar":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","en":"Then let mankind look at his food -","tj":"فَلْيَ<tajweed class=ikhafa>نظ</tajweed>ُرِ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نُ إِلَىٰ طَعَامِهِۦٓ <span class=end>٢٤</span>","pg":585},"25":{"ar":"اَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","en":"How We poured down water in torrents,","tj":"أَ<tajweed class=ghunnah>نّ</tajweed>َا صَبَ<tajweed class=qalaqah>بْ</tajweed>نَا <tajweed class=ham_wasl>ٱ</tajweed>لْم<tajweed class=madda_obligatory>َا</tajweed>ٓءَ صَبًّا <span class=end>٢٥</span>","pg":585},"26":{"ar":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","en":"Then We broke open the earth, splitting [it with sprouts],","tj":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ شَقَ<tajweed class=qalaqah>قْ</tajweed>نَا <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ شَقًّا <span class=end>٢٦</span>","pg":585},"27":{"ar":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","en":"And caused to grow within it grain","tj":"فَأَ<tajweed class=iqlab>نۢب</tajweed>َتْنَا فِيهَا حَبًّا <span class=end>٢٧</span>","pg":585},"28":{"ar":"وَعِنَبًۭا وَقَضْبًۭا","en":"And grapes and herbage","tj":"وَعِنَ<tajweed class=idgham_ghunnah>بًا و</tajweed>َقَضْبًا <span class=end>٢٨</span>","pg":585},"29":{"ar":"وَزَيْتُونًۭا وَنَخْلًۭا","en":"And olive and palm trees","tj":"وَزَيْتُو<tajweed class=idgham_ghunnah>نًا و</tajweed>َنَخْلاً <span class=end>٢٩</span>","pg":585},"30":{"ar":"وَحَدَآئِقَ غُلْبًۭا","en":"And gardens of dense shrubbery","tj":"وَحَد<tajweed class=madda_obligatory>َا</tajweed>ٓئِقَ غُلْبًا <span class=end>٣٠</span>","pg":585},"31":{"ar":"وَفَـٰكِهَةًۭ وَأَبًّۭا","en":"And fruit and grass -","tj":"وَفَ<tajweed class=madda_normal>ـٰ</tajweed>كِهَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َأَبًّا <span class=end>٣١</span>","pg":585},"32":{"ar":"مَّتَـٰعًۭا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","en":"[As] enjoyment for you and your grazing livestock.","tj":"مَّتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>عًا ل</tajweed>َّكُمْ وَلِأَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مِكُمْ <span class=end>٣٢</span>","pg":585},"33":{"ar":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","en":"But when there comes the Deafening Blast","tj":"فَإِذَا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَتِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صّ<tajweed class=madda_necessary>َا</tajweed>ٓخَّةُ <span class=end>٣٣</span>","pg":585},"34":{"ar":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","en":"On the Day a man will flee from his brother","tj":"يَوْمَ يَفِرُّ <tajweed class=ham_wasl>ٱ</tajweed>لْمَرْءُ مِنْ أَخ<tajweed class=madda_permissible>ِي</tajweed>هِ <span class=end>٣٤</span>","pg":585},"35":{"ar":"وَأُمِّهِۦ وَأَبِيهِ","en":"And his mother and his father","tj":"وَأُ<tajweed class=ghunnah>مّ</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> وَأَب<tajweed class=madda_permissible>ِي</tajweed>هِ <span class=end>٣٥</span>","pg":585},"36":{"ar":"وَصَـٰحِبَتِهِۦ وَبَنِيهِ","en":"And his wife and his children,","tj":"وَصَ<tajweed class=madda_normal>ـٰ</tajweed>حِبَتِه<tajweed class=madda_normal>ِۦ</tajweed> وَبَن<tajweed class=madda_permissible>ِي</tajweed>هِ <span class=end>٣٦</span>","pg":585},"37":{"ar":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","en":"For every man, that Day, will be a matter adequate for him.","tj":"لِكُلِّ <tajweed class=ham_wasl>ٱ</tajweed>مْرِى<tajweed class=idgham_ghunnah>ٍٕ م</tajweed>ِّنْهُمْ يَوْمَئِ<tajweed class=ikhafa>ذٍ ش</tajweed>َأْ<tajweed class=idgham_ghunnah>نٌ ي</tajweed>ُغْن<tajweed class=madda_permissible>ِي</tajweed>هِ <span class=end>٣٧</span>","pg":585},"38":{"ar":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","en":"[Some] faces, that Day, will be bright -","tj":"وُجُو<tajweed class=idgham_ghunnah>هٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_ghunnah>ذٍ م</tajweed>ُّسْفِرَةٌ <span class=end>٣٨</span>","pg":585},"39":{"ar":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","en":"Laughing, rejoicing at good news.","tj":"ضَاحِكَ<tajweed class=idgham_ghunnah>ةٌ م</tajweed>ُّسْتَ<tajweed class=qalaqah>بْ</tajweed>شِرَةٌ <span class=end>٣٩</span>","pg":585},"40":{"ar":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","en":"And [other] faces, that Day, will have upon them dust.","tj":"وَوُجُو<tajweed class=idgham_ghunnah>هٌ ي</tajweed>َوْمَئِذٍ عَلَيْهَا غَبَرَةٌ <span class=end>٤٠</span>","pg":585},"41":{"ar":"تَرْهَقُهَا قَتَرَةٌ","en":"Blackness will cover them.","tj":"تَرْهَقُهَا قَتَرَةٌ <span class=end>٤١</span>","pg":586},"42":{"ar":"أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","en":"Those are the disbelievers, the wicked ones.","tj":"أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْكَفَرَةُ <tajweed class=ham_wasl>ٱ</tajweed>لْفَجَرَةُ <span class=end>٤٢</span>","pg":586}}