{"1":{"ar":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","en":"When the sun is wrapped up [in darkness]","tj":"إِذَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّمْسُ كُوِّرَتْ <span class=end>١</span>","pg":586},"2":{"ar":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","en":"And when the stars fall, dispersing,","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>ُجُومُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نك</tajweed>َدَرَتْ <span class=end>٢</span>","pg":586},"3":{"ar":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","en":"And when the mountains are removed","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed>لْجِبَالُ سُيِّرَتْ <span class=end>٣</span>","pg":586},"4":{"ar":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","en":"And when full-term she-camels are neglected","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed>لْعِشَارُ عُطِّلَتْ <span class=end>٤</span>","pg":586},"5":{"ar":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","en":"And when the wild beasts are gathered","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed>لْوُحُوشُ حُشِرَتْ <span class=end>٥</span>","pg":586},"6":{"ar":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","en":"And when the seas are filled with flame","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed>لْبِحَارُ سُجِّرَتْ <span class=end>٦</span>","pg":586},"7":{"ar":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","en":"And when the souls are paired","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>ُفُوسُ زُوِّجَتْ <span class=end>٧</span>","pg":586},"8":{"ar":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","en":"And when the girl [who was] buried alive is asked","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed>لْمَوْءُ<tajweed class=madda_normal>ۥ</tajweed>دَةُ سُئِلَتْ <span class=end>٨</span>","pg":586},"9":{"ar":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","en":"For what sin she was killed","tj":"بِأَىِّ ذَ<tajweed class=iqlab>نۢب</tajweed><tajweed class=ikhafa>ٍ ق</tajweed>ُتِلَتْ <span class=end>٩</span>","pg":586},"10":{"ar":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","en":"And when the pages are made public","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّحُفُ نُشِرَتْ <span class=end>١٠</span>","pg":586},"11":{"ar":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","en":"And when the sky is stripped away","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءُ كُشِطَتْ <span class=end>١١</span>","pg":586},"12":{"ar":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","en":"And when Hellfire is set ablaze","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed>لْجَحِيمُ سُعِّرَتْ <span class=end>١٢</span>","pg":586},"13":{"ar":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","en":"And when Paradise is brought near,","tj":"وَإِذَا <tajweed class=ham_wasl>ٱ</tajweed>لْجَ<tajweed class=ghunnah>نّ</tajweed>َةُ أُزْلِفَتْ <span class=end>١٣</span>","pg":586},"14":{"ar":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","en":"A soul will [then] know what it has brought [with it].","tj":"عَلِمَتْ نَفْ<tajweed class=idgham_ghunnah>سٌ م</tajweed>ّ<tajweed class=madda_obligatory>َآ</tajweed> أَحْضَرَتْ <span class=end>١٤</span>","pg":586},"15":{"ar":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","en":"So I swear by the retreating stars -","tj":"فَل<tajweed class=madda_obligatory>َآ</tajweed> أُ<tajweed class=qalaqah>قْ</tajweed>سِمُ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْخُ<tajweed class=ghunnah>نّ</tajweed>َسِ <span class=end>١٥</span>","pg":586},"16":{"ar":"ٱلْجَوَارِ ٱلْكُنَّسِ","en":"Those that run [their courses] and disappear -","tj":"ٱلْجَوَارِ <tajweed class=ham_wasl>ٱ</tajweed>لْكُ<tajweed class=ghunnah>نّ</tajweed>َسِ <span class=end>١٦</span>","pg":586},"17":{"ar":"وَٱلَّيْلِ إِذَا عَسْعَسَ","en":"And by the night as it closes in","tj":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّيْلِ إِذَا عَسْعَسَ <span class=end>١٧</span>","pg":586},"18":{"ar":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","en":"And by the dawn when it breathes","tj":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّ<tajweed class=qalaqah>بْ</tajweed>حِ إِذَا تَنَفَّسَ <span class=end>١٨</span>","pg":586},"19":{"ar":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","en":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَقَوْلُ رَسُو<tajweed class=ikhafa>لٍ ك</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>١٩</span>","pg":586},"20":{"ar":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","en":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],","tj":"ذِى قُوَّةٍ عِ<tajweed class=ikhafa>ند</tajweed>َ ذِى <tajweed class=ham_wasl>ٱ</tajweed>لْعَرْشِ مَك<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٢٠</span>","pg":586},"21":{"ar":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","en":"Obeyed there [in the heavens] and trustworthy.","tj":"مُّطَا<tajweed class=ikhafa>عٍ ث</tajweed>َ<tajweed class=ghunnah>مّ</tajweed>َ أَم<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٢١</span>","pg":586},"22":{"ar":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","en":"And your companion is not [at all] mad.","tj":"وَمَا صَاحِبُك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِمَ<tajweed class=qalaqah>جْ</tajweed>ن<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>٢٢</span>","pg":586},"23":{"ar":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","en":"And he has already seen Gabriel in the clear horizon.","tj":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> رَءَاهُ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْأُفُقِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُب<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٢٣</span>","pg":586},"24":{"ar":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","en":"And Muhammad is not a withholder of [knowledge of] the unseen.","tj":"وَمَا هُوَ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْغَيْبِ بِضَن<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٢٤</span>","pg":586},"25":{"ar":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍۢ رَّجِيمٍۢ","en":"And the Qur'an is not the word of a devil, expelled [from the heavens].","tj":"وَمَا هُوَ بِقَوْلِ شَيْطَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>نٍ ر</tajweed>َّج<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٢٥</span>","pg":586},"26":{"ar":"فَأَيْنَ تَذْهَبُونَ","en":"So where are you going?","tj":"فَأَيْنَ تَذْهَب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٦</span>","pg":586},"27":{"ar":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَـٰلَمِينَ","en":"It is not except a reminder to the worlds","tj":"إِنْ هُوَ إِلَّا ذِكْ<tajweed class=idgham_wo_ghunnah>رٌ ل</tajweed>ِّلْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٧</span>","pg":586},"28":{"ar":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","en":"For whoever wills among you to take a right course.","tj":"لِمَ<tajweed class=ikhafa>ن ش</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءَ مِ<tajweed class=ikhafa>نك</tajweed>ُمْ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َسْتَق<tajweed class=madda_permissible>ِي</tajweed>مَ <span class=end>٢٨</span>","pg":586},"29":{"ar":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","en":"And you do not will except that Allah wills - Lord of the worlds.","tj":"وَمَا تَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُونَ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َش<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ رَبُّ <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٩</span>","pg":586}}